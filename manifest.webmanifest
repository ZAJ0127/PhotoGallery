{
  "name": "Photo Sorter",
  "short_name": "Sorter",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#111114",
  "theme_color": "#111114",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [ { "name": "photos", "accept": ["image/*"] } ] }
  }
}
